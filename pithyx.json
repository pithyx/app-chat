{
  "$schema": "./node_modules/@pithyx/sdk/schema/manifest.v2.schema.json",
  "manifestVersion": 2,
  "id": "com.example.chat",
  "version": "1.0.0",
  "name": {
    "en": "Chat",
    "de": "Chat"
  },
  "description": {
    "en": "A team chat for everybody on the box, with notifications and an unread count.",
    "de": "Ein Team-Chat für alle auf der Box, mit Benachrichtigungen und Zähler für Ungelesenes."
  },
  "author": {
    "name": "Your name"
  },
  "license": "MIT",
  "entry": "frontend/index.html",
  "sdk": "^2.1.0",
  "arch": [
    "amd64",
    "arm64"
  ],
  "source": "https://github.com/pithyx/app-chat",
  "privacy": {
    "sends": "none"
  },
  "permissions": {
    "notifications": {
      "reason": {
        "en": "Tells you about new messages.",
        "de": "Sagt dir Bescheid bei neuen Nachrichten."
      }
    },
    "directory.read": {
      "reason": {
        "en": "Shows who is in the chat with their names.",
        "de": "Zeigt, wer im Chat ist, mit Namen."
      }
    }
  },
  "window": {
    "instances": "single",
    "defaultSize": {
      "width": 720,
      "height": 560
    },
    "minSize": {
      "width": 320,
      "height": 400
    }
  },
  "backend": {
    "compose": "backend/compose.yaml",
    "endpoints": {
      "api": {
        "service": "server",
        "port": 8080
      }
    },
    "lifecycle": "onDemand",
    "idleTimeout": 600,
    "health": {
      "endpoint": "api",
      "path": "/healthz"
    }
  }
}
