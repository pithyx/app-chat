{
  "name": "app-chat",
  "version": "1.0.0",
  "private": true,
  "description": "A team chat as a Pithyx app: React with @pithyx/ui, a Node.js backend with a WebSocket and SQLite in a volume.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:backend": "pithyx build",
    "test": "npm run build && pithyx validate && vitest run",
    "pack": "npm run build && pithyx build && pithyx pack --images"
  },
  "dependencies": {
    "@pithyx/sdk": "1.0.0-rc.3",
    "@pithyx/ui": "1.0.0-rc.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@pithyx/cli": "1.0.0-rc.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=24"
  }
}
